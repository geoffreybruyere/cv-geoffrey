<script>
(function(){
  var GATE='opaline', KEY='gb_gemmyo_ok';
  var gate=document.getElementById('gate'),
      form=document.getElementById('gateForm'),
      input=document.getElementById('gateInput'),
      err=document.getElementById('gateErr'),
      card=document.getElementById('gateCard'),
      content=document.getElementById('content');
  function open(){
    gate.hidden=true; content.hidden=false; window.scrollTo(0,0);
  }
  if(sessionStorage.getItem(KEY)) open();
  form.addEventListener('submit', function(e){
    e.preventDefault();
    if(input.value.trim().toLowerCase()===GATE){
      sessionStorage.setItem(KEY,'1'); open();
    } else {
      err.textContent='Mot de passe incorrect.';
      card.classList.remove('gate-shake');
      void card.offsetWidth;
      card.classList.add('gate-shake');
      input.select();
    }
  });
  input.focus();
})();
</script>
