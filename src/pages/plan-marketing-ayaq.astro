      .gate-question { padding: 2rem; display: grid; grid-template-columns: 10rem 1fr; color: var(--white); background: var(--ink); }
      .gate-question span { color: var(--red); font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
      .gate-question strong { font-size: clamp(1.4rem, 2.4vw, 2.5rem); font-weight: 500; letter-spacing: -.03em; }
      .odyssee-gate ul { padding: 0; margin: 0; display: grid; grid-template-columns: repeat(5, 1fr); list-style: none; }
      .odyssee-gate li { min-height: 11rem; padding: 1.5rem; border-right: 1px solid var(--ink); display: flex; align-items: end; font-size: .8rem; }
      .odyssee-gate li:last-child { border-right: 0; }
      .gate-outcomes { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--ink); }
      .gate-outcomes p { padding: 2rem; display: grid; grid-template-columns: 5rem 1fr; border-right: 1px solid var(--ink); }
      .gate-outcomes p:last-child { border-right: 0; }
      .gate-outcomes strong { color: var(--red); text-transform: uppercase; }

      .budget-head { display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: end; }
      .budget-split { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid #454642; }
      .budget-split p { min-width: 10rem; padding: 1.2rem; border-right: 1px solid #454642; }
      .budget-split p:last-child { border-right: 0; }
      .budget-split strong, .budget-split span { display: block; }
      .budget-split strong { color: var(--red); font-size: 2.2rem; font-weight: 500; line-height: 1; }
      .budget-split span { margin-top: .4rem; color: #979994; font-size: .65rem; text-transform: uppercase; }
      .budget-bars { max-width: 85rem; margin: clamp(4rem, 8vw, 7rem) auto 0; }
      .budget-bars article { min-height: 3.8rem; display: grid; grid-template-columns: minmax(16rem, .8fr) 1.2fr 5rem; gap: 2rem; align-items: center; border-top: 1px solid #3e3f3c; }
      .budget-bars article:last-child { border-bottom: 1px solid #3e3f3c; }
      .budget-label span, .budget-label small { display: block; }
      .budget-label span { font-size: .82rem; }
      .budget-label small { margin-top: .1rem; color: #7f817c; font-size: .62rem; }
      .bar-track { height: 7px; background: #343532; }
      .bar-track i { height: 100%; display: block; background: var(--red); }
      .bar-track .w40 { width: 100%; }
      .bar-track .w25 { width: 62.5%; }
      .bar-track .w15 { width: 37.5%; }
      .bar-track .w10 { width: 25%; }
      .budget-bars article > strong { color: var(--white); font-size: 1rem; font-weight: 500; text-align: right; }
      .unlock-rules { max-width: 85rem; margin: 3rem auto 0; padding: 2rem; display: grid; grid-template-columns: .5fr 1.5fr; border: 1px solid #454642; }
      .unlock-rules p { color: var(--red); font-weight: 600; }
      .unlock-rules ol { padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); list-style-position: inside; color: #a7a9a3; font-size: .78rem; }

      .phase-list { margin-top: clamp(4rem, 8vw, 8rem); border-top: 1px solid var(--ink); }
      .phase-list article { padding: 2.5rem 0; display: grid; grid-template-columns: .55fr 1fr 1.3fr .8fr; gap: 2.5rem; border-bottom: 1px solid var(--ink); }
      .phase-marker b, .phase-marker span { display: block; }
      .phase-marker b { color: var(--red); font-size: 2.5rem; font-weight: 400; letter-spacing: -.05em; }
      .phase-marker span, .phase-title small, .phase-list article > p span { color: var(--muted); font-size: .65rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
      .phase-title h3 { margin-top: .5rem; font-size: 1.45rem; }
      .phase-list ul { padding: 0; margin: 0; list-style: none; }
      .phase-list li { padding: .35rem 0; color: #545651; font-size: .78rem; }
      .phase-list li::before { margin-right: .7rem; content: "·"; color: var(--red); }
      .phase-list article > p { padding-left: 1.5rem; border-left: 1px solid var(--line); color: #545651; font-size: .78rem; }
      .phase-list article > p span { margin-bottom: .7rem; display: block; color: var(--red); }

      .scoreboard-grid { margin-top: clamp(4rem, 8vw, 8rem); display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--ink); border-left: 1px solid var(--ink); }
      .scoreboard-grid article { min-height: 17rem; padding: 2rem; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
      .scoreboard-grid span { color: var(--red); font-size: .7rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
      .scoreboard-grid ul { padding: 0; margin: 3rem 0 0; list-style: none; }
      .scoreboard-grid li { padding: .4rem 0; border-top: 1px solid var(--line); color: #5d5f5a; font-size: .78rem; }

      .first-month { display: grid; grid-template-columns: 1fr 1fr; color: var(--white); background: var(--red); }
      .first-month-image { min-height: 42rem; overflow: hidden; }
      .first-month-image img { width: 100%; height: 100%; object-fit: cover; }
      .first-month-copy { padding: clamp(4rem, 8vw, 8rem) var(--pad); }
      .first-month-copy h2 { max-width: 11ch; }
      .first-month-copy ol { padding: 0; margin: 4rem 0 0; list-style: none; counter-reset: firstmonth; }
      .first-month-copy li { padding: .75rem 0; border-top: 1px solid rgba(248,248,246,.45); counter-increment: firstmonth; }
      .first-month-copy li::before { margin-right: 1rem; content: "0" counter(firstmonth); font-size: .65rem; font-weight: 700; }

      .decisions-head h2 { max-width: 14ch; }
      .decision-list { padding: 0; margin: clamp(4rem, 8vw, 8rem) 0 0; border-top: 1px solid #454642; list-style: none; }
      .decision-list li { padding: 1.5rem 0; display: grid; grid-template-columns: 5rem 1fr; border-bottom: 1px solid #454642; font-size: clamp(1.1rem, 1.7vw, 1.55rem); }
      .decision-list b { color: var(--red); font-size: .7rem; }

      .closing { padding: clamp(7rem, 14vw, 14rem) var(--pad); text-align: center; background: var(--white); }
      .closing .kicker::before { display: none; }
      .closing h2 { max-width: 14ch; margin: auto; font-size: clamp(3.5rem, 8vw, 9rem); }
      .closing > p:not(.kicker) { max-width: 55rem; margin: 3rem auto 0; color: var(--muted); font-size: clamp(1rem, 1.4vw, 1.2rem); }
      .signature { margin-top: 5rem; }
      .signature strong, .signature span { display: block; }
      .signature strong { font-size: 1.1rem; }
      .signature span { margin-top: .4rem; color: var(--muted); font-size: .65rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
      footer { padding: 1.5rem var(--pad); display: grid; grid-template-columns: .8fr 1.2fr; gap: 3rem; border-top: 1px solid var(--line); color: var(--muted); background: var(--white); font-size: .62rem; }

      @media (max-width: 980px) {
        nav { display: none; }
        .hero, .positioning, .first-month { grid-template-columns: 1fr; }
        .hero-image { min-height: 65vw; }
        .truth-strip { grid-template-columns: 1fr 1fr; }
        .truth-strip div:nth-child(2) { border-right: 0; }
        .truth-strip div:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
        .starting-grid, .growth-head, .strategy-head, .offer-head, .mike-heading, .channels-head, .odyssee-head, .roadmap-head, .scoreboard-head, .unfair-intro { grid-template-columns: 1fr; }
        .positioning figure { min-height: 75vw; }
        .offer-ladder { grid-template-columns: 1fr 1fr; align-items: stretch; }
        .offer-ladder article, .offer-ladder .offer-halo, .offer-ladder .offer-entry, .offer-ladder .offer-system, .offer-ladder .offer-repeat { min-height: 24rem; border: 1px solid var(--ink); }
        .mike-timeline { grid-template-columns: 1fr 1fr; }
        .asset-engine { grid-column: span 2; order: 3; display: grid; grid-template-columns: repeat(4, 1fr); }
        .asset-engine strong, .asset-engine i { grid-column: span 2; }
        .phase-list article { grid-template-columns: .4fr 1fr 1.3fr; }
        .phase-list article > p { grid-column: 2 / -1; }
        .budget-bars article { grid-template-columns: minmax(13rem, .9fr) 1.1fr 4rem; }
      }

      @media (max-width: 700px) {
        .site-header { height: 58px; }
        .brand span, .print-button { display: none; }
        .hero { min-height: 0; }
        .hero-copy { min-height: 42rem; }
        .hero-topline p:last-child { display: none; }
        .hero-objectives { grid-template-columns: 1fr; }
        .hero-objectives div { padding: .85rem 0; display: grid; grid-template-columns: 6rem 1fr; border-top: 1px solid #42433f; align-items: center; }
        .hero-objectives strong { font-size: 2.2rem; }
        .hero-objectives span { margin: 0; }
        .truth-strip { grid-template-columns: 1fr; }
        .truth-strip div { min-height: 0; padding: 1.4rem var(--pad); border-right: 0; border-bottom: 1px solid var(--line); }
        .truth-strip div:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
        .truth-strip strong { margin: .8rem 0 .4rem; font-size: 2.3rem; }
        .manifesto { grid-template-columns: 1fr; }
        .evidence-list article { grid-template-columns: 1fr; }
        .evidence-list article > span { grid-row: auto; }
        .fact-legend { flex-direction: column; gap: .7rem; }
        .growth-viz { grid-template-columns: 1fr; grid-template-rows: auto; }
        .growth-base { grid-row: auto; border-right: 0; border-bottom: 1px solid var(--ink); }
        .growth-viz > div { min-height: 11rem; }
        .growth-viz strong { font-size: 3.5rem; }
        .equation { grid-template-columns: 1fr; }
        .equation p { border-right: 0; border-bottom: 1px solid var(--ink); }
        .four-bets { display: block; }
        .four-bets article { margin-top: 3rem; }
        .positioning dl div { grid-template-columns: 1fr; }
        .offer-ladder { grid-template-columns: 1fr; }
        .offer-ladder article, .offer-ladder .offer-halo, .offer-ladder .offer-entry, .offer-ladder .offer-system, .offer-ladder .offer-repeat { min-height: 20rem; }
        .people { grid-template-columns: 1fr; }
        .people figure { height: 110vw; }
        .advantage-lines article { grid-template-columns: 2rem 1fr; }
        .advantage-lines p { grid-column: 2; }
        .mike-timeline { grid-template-columns: 1fr; }
        .mike-timeline > article, .mike-timeline > article:first-child, .mike-timeline > article:last-child { padding: 2rem 0; }
        .asset-engine { grid-column: auto; order: 0; grid-template-columns: 1fr 1fr; }
        .asset-engine strong, .asset-engine i { grid-column: span 2; }
        .channel-grid { grid-template-columns: 1fr; }
        .channel-grid article { min-height: 30rem; padding: 2rem 0; border-right: 0; }
        .gate-question { grid-template-columns: 1fr; gap: 1rem; }
        .odyssee-gate ul { grid-template-columns: 1fr; }
        .odyssee-gate li { min-height: 0; border-right: 0; border-bottom: 1px solid var(--ink); }
        .gate-outcomes { grid-template-columns: 1fr; }
        .gate-outcomes p { grid-template-columns: 3rem 1fr; border-right: 0; border-bottom: 1px solid var(--ink); }
        .budget-head { grid-template-columns: 1fr; }
        .budget-bars article { padding: 1rem 0; grid-template-columns: 1fr 4rem; gap: 1rem; }
        .bar-track { grid-column: span 2; grid-row: 2; }
        .unlock-rules { grid-template-columns: 1fr; gap: 1.5rem; }
        .unlock-rules ol { grid-template-columns: 1fr 1fr; gap: .8rem; }
        .phase-list article { grid-template-columns: 4rem 1fr; }
        .phase-list ul, .phase-list article > p { grid-column: 2; }
        .scoreboard-grid { grid-template-columns: 1fr; }
        .scoreboard-grid article { min-height: 14rem; }
        .first-month-image { min-height: 62vw; }
        .decision-list li { grid-template-columns: 3rem 1fr; }
        footer { grid-template-columns: 1fr; gap: .7rem; }
      }

      @media print {
        @page { size: A4; margin: 11mm; }
        body { color: #101110; background: #fff; font-size: 9pt; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
        .site-header, .access, footer { display: none !important; }
        .hero { min-height: 275mm; grid-template-columns: 1.08fr .92fr; break-after: page; }
        .hero-copy { min-height: 275mm; padding: 18mm 12mm; }
        .hero-image { min-height: 275mm; }
        .truth-strip, .manifesto, .starting-point, .growth, .strategy, .positioning, .offer, .unfair, .mike-plan, .channels, .odyssee, .budget, .roadmap, .scoreboard, .first-month, .board-decisions, .closing { break-before: page; }
        .section-light, .section-paper, .section-dark, .manifesto, .roadmap, .scoreboard, .board-decisions { padding: 16mm 0; }
        .section-index { margin-bottom: 12mm; }
        h1 { font-size: 48pt; }
        h2 { font-size: 34pt; }
        .truth-strip div { min-height: 45mm; }
        .positioning figure, .people figure { min-height: 245mm; }
        .phase-list article { break-inside: avoid; }
      }
    </style>
  </body>
</html>
