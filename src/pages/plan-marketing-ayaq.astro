      const accessForm = document.querySelector("#access-form");
      const accessError = document.querySelector("#access-error");

      function unlock() {
        document.body.removeAttribute("data-locked");
        document.querySelector("#access")?.remove();
      }

      if (localStorage.getItem("ayaq-plan-access") === "granted") unlock();

      accessForm?.addEventListener("submit", (event) => {
        event.preventDefault();
        const password = new FormData(accessForm).get("password");
        if (password === "aventure") {
          localStorage.setItem("ayaq-plan-access", "granted");
          unlock();
          return;
        }
        accessError.hidden = false;
        accessForm.querySelector("input")?.focus();
